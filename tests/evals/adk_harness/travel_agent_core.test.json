          "travog_refresh_token": "eval-refresh-token"
        }
      },
      "conversation": [
        {
          "invocation_id": "root-routes-flight-search-1",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Find me flights from Delhi to London next Monday for one adult."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
